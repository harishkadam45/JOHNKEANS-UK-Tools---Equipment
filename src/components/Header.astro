---
import { company, nav, topNav } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const pageLinks = topNav;
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-ink-200 bg-white"
>
  <div class="container-page">
    <div class="flex h-16 items-center gap-2 lg:h-[72px]">
      <!-- Mobile menu toggle -->
      <button
        type="button"
        data-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="-ml-2 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-btn text-ink-800 hover:bg-gray-100 lg:hidden"
      >
        <Icon name="menu" class="h-6 w-6" data-icon="menu" />
        <Icon name="close" class="hidden h-6 w-6" data-icon="close" />
      </button>

      <Logo class="min-w-0 shrink" />

      <!-- Desktop navigation -->
      <nav class="ml-4 hidden min-w-0 flex-1 items-center gap-0.5 lg:flex" aria-label="Main">
        <!-- Shop: category mega panel -->
        <div class="group relative" data-dropdown>
          <button
            type="button"
            class="inline-flex h-10 shrink-0 items-center gap-1.5 rounded-btn px-3 text-[15px] font-semibold text-ink-800 transition-colors hover:bg-gray-100 hover:text-jk-700"
            aria-expanded="false"
            data-dropdown-trigger
          >
            Shop
            <Icon name="chevronDown" class="h-4 w-4 transition-transform group-hover:rotate-180" />
          </button>
          <div
            class="invisible absolute top-full left-0 w-[560px] translate-y-1 rounded-xl border border-ink-200 bg-white p-2 opacity-0 shadow-xl shadow-ink-900/8 transition-all duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
          >
            <ul class="grid grid-cols-2 gap-1">
              {
                nav.map((c) => (
                  <li>
                    <a
                      href={`/${c.slug}`}
                      class="flex items-center gap-3 rounded-lg bg-gray-100 px-3 py-2.5 transition-colors hover:bg-jk-50"
                    >
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-jk-600 text-white">
                        <Icon name={c.icon} class="h-5 w-5" />
                      </span>
                      <span class="min-w-0">
                        <span class="block truncate text-sm font-semibold text-ink-900">
                          {c.label}
                        </span>
                        <span class="block text-xs text-ink-500">Browse range</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="mt-1 flex items-center justify-between gap-3 rounded-lg bg-gray-100 px-3 py-2.5">
              <span class="text-[13px] text-ink-600">
                Buying for a business or in volume?
              </span>
              <a
                href="/request-a-quote"
                class="inline-flex min-h-9 shrink-0 items-center gap-1 py-1.5 text-[13px] font-semibold text-jk-700 hover:text-jk-600"
              >
                Request a Quote <Icon name="arrowRight" class="h-4 w-4" />
              </a>
            </div>
          </div>
        </div>

        {
          pageLinks.map((l) => (
            <a
              href={`/${l.slug}`}
              class="inline-flex h-10 shrink-0 items-center rounded-btn px-3 text-[15px] font-semibold whitespace-nowrap text-ink-800 transition-colors hover:bg-gray-100 hover:text-jk-700"
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      <!-- Actions -->
      <div class="ml-auto flex shrink-0 items-center gap-0.5 lg:gap-1">
        <form role="search" class="hidden 2xl:block" action="/search">
          <label for="site-search" class="sr-only">Search products</label>
          <div class="relative">
            <input
              id="site-search"
              type="search"
              name="q"
              placeholder="Search by product, model or SKU"
              class="h-10 w-64 rounded-btn border border-ink-200 bg-gray-100 pr-10 pl-3 text-sm text-ink-800 transition-colors placeholder:text-ink-400 hover:border-ink-300 focus:border-jk-600 focus:bg-white focus:outline-none"
            />
            <button
              type="submit"
              aria-label="Search"
              class="absolute top-1/2 right-1 -translate-y-1/2 rounded p-2 text-ink-500 hover:text-jk-700"
            >
              <Icon name="search" class="h-4.5 w-4.5" />
            </button>
          </div>
        </form>
        <button
          type="button"
          aria-label="Search"
          class="hidden h-10 w-10 items-center justify-center rounded-btn text-ink-700 hover:bg-gray-100 min-[400px]:inline-flex 2xl:hidden"
        >
          <Icon name="search" class="h-5 w-5" />
        </button>
        <a
          href="/account"
          aria-label="Your account"
          class="hidden h-10 w-10 items-center justify-center rounded-btn text-ink-700 hover:bg-gray-100 sm:inline-flex"
        >
          <Icon name="user" class="h-5 w-5" />
        </a>
        <!-- Wishlist intentionally omitted: brief says remove wishlist site-wide -->
        <a
          href="/cart"
          class="relative inline-flex h-10 w-10 items-center justify-center rounded-btn text-ink-700 hover:bg-gray-100"
          aria-label="Shopping cart, 2 items"
        >
          <Icon name="cart" class="h-5.5 w-5.5" />
          <span
            data-cart-count
            class="absolute top-1 right-0.5 flex h-4.5 min-w-4.5 items-center justify-center rounded-full bg-jk-600 px-1 text-[10.5px] font-bold text-white"
          >
            2
          </span>
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile navigation -->
  <div
    id="mobile-nav"
    data-mobile-nav
    class="no-scrollbar hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-ink-200 bg-white lg:hidden"
  >
    <div class="container-page space-y-5 py-4">
      <form role="search" action="/search" class="lg:hidden">
        <div class="relative">
          <input
            type="search"
            name="q"
            placeholder="Search by product, model or SKU"
            class="h-11 w-full rounded-btn border border-ink-200 bg-gray-100 pr-10 pl-3 text-sm focus:border-jk-600 focus:bg-white focus:outline-none"
          />
          <button
            type="submit"
            aria-label="Search"
            class="absolute top-1/2 right-1 -translate-y-1/2 rounded p-2 text-ink-500"
          >
            <Icon name="search" class="h-5 w-5" />
          </button>
        </div>
      </form>

      <div>
        <p class="eyebrow px-1 pb-2">Shop by category</p>
        <ul class="grid grid-cols-2 gap-2">
          {
            nav.map((c) => (
              <li class="min-w-0">
                <a
                  href={`/${c.slug}`}
                  class="flex min-h-11 items-center justify-between gap-2 rounded-lg bg-gray-100 px-3 py-2.5 text-[13px] font-semibold text-ink-800 transition-colors hover:bg-jk-50 hover:text-jk-700"
                >
                  <span class="truncate">{c.label}</span>
                  <Icon name="chevronRight" class="h-4 w-4 shrink-0 text-ink-400" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="eyebrow px-1 pb-2">Explore</p>
        <ul class="grid grid-cols-2 gap-2">
          {
            pageLinks.map((l) => (
              <li class="min-w-0">
                <a
                  href={`/${l.slug}`}
                  class="flex min-h-11 items-center justify-between gap-2 rounded-lg bg-gray-100 px-3 py-2.5 text-[13px] font-semibold text-ink-800 transition-colors hover:bg-jk-50 hover:text-jk-700"
                >
                  <span class="truncate">{l.label}</span>
                  <Icon name="chevronRight" class="h-4 w-4 shrink-0 text-ink-400" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <a
        href={`tel:${company.phoneHref}`}
        class="btn btn-md btn-outline w-full"
      >
        <Icon name="phone" class="h-4.5 w-4.5" />
        {company.phone}
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = header?.querySelector<HTMLElement>('[data-mobile-nav]');
  const iconMenu = header?.querySelector<SVGElement>('[data-icon="menu"]');
  const iconClose = header?.querySelector<SVGElement>('[data-icon="close"]');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    panel?.classList.toggle('hidden', open);
    iconMenu?.classList.toggle('hidden', !open);
    iconClose?.classList.toggle('hidden', open);
  });

  // Mobile: close the panel when a link inside it is used
  panel?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) toggle?.click();
  });

  // Add a soft shadow once the page scrolls
  const onScroll = () => header?.classList.toggle('shadow-md', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
