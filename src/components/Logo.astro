---
interface Props {
  class?: string;
  tone?: 'dark' | 'light';
  compact?: boolean;
}
const { class: className = '', tone = 'dark', compact = false } = Astro.props;
const word = tone === 'dark' ? 'text-ink-900' : 'text-white';
const sub = tone === 'dark' ? 'text-jk-600' : 'text-jk-300';
---

<a href="/" class={`group inline-flex items-center gap-2 sm:gap-2.5 ${className}`} aria-label="JOHNKEANS home">
  <!-- Mark: a stylised "JK" monogram inside a hex nut -->
  <svg viewBox="0 0 40 40" class="h-8 w-8 shrink-0 sm:h-9 sm:w-9 lg:h-10 lg:w-10" aria-hidden="true">
    <path
      d="M20 1.6 36.4 10.8v18.4L20 38.4 3.6 29.2V10.8Z"
      fill="var(--color-jk-600)"
      stroke="var(--color-jk-700)"
      stroke-width="1.6"
      stroke-linejoin="round"></path>
    <path
      d="M20 5.4 32.7 12.6v14.8L20 34.6 7.3 27.4V12.6Z"
      fill="none"
      stroke="#fff"
      stroke-opacity=".38"
      stroke-width="1.2"
      stroke-linejoin="round"></path>
    <path
      d="M13 26V14l7.4 8.4L27.6 14v12"
      fill="none"
      stroke="#fff"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="flex min-w-0 flex-col leading-none">
    <span class={`truncate text-[16px] font-extrabold tracking-tight sm:text-[19px] ${word}`}>JOHNKEANS</span>
    <span
      class={`mt-1 hidden text-[9.5px] font-semibold tracking-[0.22em] uppercase sm:block ${sub} ${compact ? 'lg:hidden' : ''}`}
    >
      UK Tools &amp; Equipment
    </span>
  </span>
</a>
